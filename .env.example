# Canonical production origin — used by SEO metadata, sitemap, robots, and JSON-LD.
# No trailing slash. Falls back to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=https://viki.example.co.nz

# Supabase project (see docs/superpowers/specs/2026-07-22-viki-admin-design.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Windcave HIT terminal (card present) — see docs/windcave-integration.md
WINDCAVE_HIT_URL=https://uat.windcave.com/hit/pos.aspx
WINDCAVE_HIT_USER=VinapageUAT_HIT
# Server-only. Rotate in Payline before first use. Never commit.
WINDCAVE_HIT_KEY=
WINDCAVE_HIT_STATION=3425240086
WINDCAVE_HIT_POS_NAME=Viki
WINDCAVE_CURRENCY=NZD

# Admin panel password login (works without a Supabase user).
# Local dev defaults to admin/admin. In PRODUCTION this login is disabled
# unless ADMIN_LOGIN_PASSWORD is set — never ship a guessable default.
ADMIN_LOGIN_USER=admin
ADMIN_LOGIN_PASSWORD=
# Optional HMAC key for the session cookie. Falls back to SUPABASE_SERVICE_ROLE_KEY.
ADMIN_SESSION_SECRET=
