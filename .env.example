# Canonical production origin — used by SEO metadata, sitemap, robots, and JSON-LD.
# No trailing slash. Falls back to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=https://viki.example.co.nz

# Supabase project (see docs/superpowers/specs/2026-07-22-viki-admin-design.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=
